# Copy to .env and adjust. The app reads it directly when run on the host, and
# docker compose injects the same file into the app container. Compose overrides
# only the addresses that must use service names instead of localhost.
#
# Every knob below is parsed ONCE at startup into the typed `Config`; nothing is
# re-read per request. `APP_ENV=production` additionally runs a startup
# validation that REFUSES to boot when any of these is missing or still on a
# development default (see "Startup validation" in docs/deployment.md):
#
#   BASE_URL (not localhost)   S3_ENDPOINT / S3_BUCKET / S3_ACCESS_KEY_ID /
#   S3_SECRET_ACCESS_KEY (not `minioadmin`)   EMAIL_PROVIDER=smtp|resend with
#   its credentials   LOCATION_PROVIDER=mapbox|google with its credentials   VALKEY_URL or
#   VALKEY_CLUSTER_URLS   TLS_ON=true   CSP_MEDIA_HOSTS   GOOGLE_OAUTH_ENABLED=false
#
# Development (the default) validates nothing and logs a warning naming each
# fake it is running on.

# Deployment kind: development (default) | production. Production switches logs
# to JSON and turns on the startup validation described above.
# APP_ENV=development

# PostgreSQL connection (host port configurable via DB_HOST_PORT). The only
# variable required in development.
DATABASE_URL=postgres://bikesnest:bikesnest@localhost:5432/bikesnest
DB_HOST_PORT=5432

# Docker Compose-only settings. These keep `.env` usable both from the host and
# inside containers, where `localhost` would point at the app container itself.
# POSTGRES_USER=bikesnest
# POSTGRES_PASSWORD=bikesnest
# POSTGRES_DB=bikesnest
# COMPOSE_BIND_ADDR=0.0.0.0:8080
# COMPOSE_MEDIA_ROOT=/app/media
# APP_HOST_PORT=8080
# MAILPIT_SMTP_HOST_PORT=1025
# MAILPIT_UI_HOST_PORT=8025
# MINIO_API_HOST_PORT=9000
# MINIO_CONSOLE_HOST_PORT=9001

# Connection pool + per-connection guard rails. Every pooled connection is
# opened with these two timeouts, so one runaway query (or a transaction left
# open by a crashed client) releases its connection instead of pinning it — and,
# past DB_MAX_CONNECTIONS of those, the whole pool. Size the pool for the
# database's own max_connections divided by the number of app replicas.
# Migrations are exempt (they run with the statement timeout disabled), but a
# long maintenance task run through the app — e.g. the `retention` subcommand on
# a large database — may need a higher DB_STATEMENT_TIMEOUT_MS.
# DB_MAX_CONNECTIONS=10
# DB_STATEMENT_TIMEOUT_MS=5000
# DB_IDLE_IN_TX_TIMEOUT_MS=10000

# HTTP bind address
BIND_ADDR=0.0.0.0:8080

# Number of reverse proxies in front of the app whose X-Forwarded-For entries
# are trusted; 0 = use the peer address only. Rate limits are keyed on the
# client address, and X-Forwarded-For is a header anyone can send, so it is
# ignored entirely at 0 (the default). Set it to the exact number of proxies
# that append to the header (1 behind a single load balancer, 2 behind a CDN in
# front of a load balancer, …): the entry that many places from the RIGHT is the
# address the outermost trusted proxy saw. Too high a value lets clients forge
# their address; too low keys everyone on the proxy. X-Real-IP is never read.
# TRUSTED_PROXY_HOPS=0

# Timeout for the /readyz database probe, in milliseconds.
# PROBE_TIMEOUT_MS=2000

# Log filter (tracing env-filter syntax)
RUST_LOG=info

# Directory the `/static` route serves CSS/JS/images from. Defaults to
# `web/static` relative to the working directory, falling back to the path the
# binary was compiled from, so `cargo run` from the repo works unset. The
# container image sets it explicitly (the binary is relocatable).
# STATIC_ROOT=/app/web/static

# Directory the development e-mail outbox writes readable messages to
# (`EMAIL_PROVIDER=fake` only). It is **not** a media directory any more: media
# lives in object storage (see the `S3_*` block below), and the retention
# orphan sweep lists the bucket rather than a local tree.
# MEDIA_ROOT=./media

# Accounts and authentication.
# BASE_URL builds emailed verification/reset links and canonical URLs. It
# defaults to http://localhost:8080 in development ONLY; production must set it
# to the real public origin or it refuses to start.
# BASE_URL=http://localhost:8080

# seed-admin: idempotent, env-driven admin bootstrap.
# Set these, then:  cargo run -p bikesnest-web -- seed-admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-at-least-8-chars

# Email provider (generic port): fake | smtp | resend.
#
# Transactional mail (verification, password reset, e-mail change) is written
# in the recipient's own language, taken from `users.locale`, and is delivered
# through the background job queue as an `email.send` job — not on the request
# path. So a slow relay/ESP can no longer hold a registration open. NOTE: with
# `JOBS_ENABLED=false` nothing would ever claim those rows, so the app sends
# inline instead (same provider, same rendering, on the request path).
# Dev uses smtp → Mailpit (`docker compose up -d mailpit`, UI at :8025).
# Unset selects `fake` (in-memory + outbox) so `cargo run` always works. Asking
# for smtp/resend WITHOUT its credentials is a startup error in every
# environment — it never silently degrades to the fake (which would swallow
# every verification e-mail).
EMAIL_PROVIDER=smtp
EMAIL_FROM="BikesNest <no-reply@bikesnest.local>"
# Mailpit listens on localhost:1025 (no TLS, no auth).
SMTP_HOST=localhost
SMTP_PORT=1025
# Compose defaults this internal override to `mailpit`; set it only when the app
# container should connect to a different SMTP hostname.
# COMPOSE_SMTP_HOST=mailpit
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=1                        # STARTTLS (set for a real relay; Mailpit needs none)
# Resend (EMAIL_PROVIDER=resend):
# RESEND_API_KEY=
# RESEND_FROM=BikesNest <onboarding@resend.dev>

# Fake Google OAuth stub: deterministic dev identity, used only when Google
# sign-in is enabled below.
# FAKE_OAUTH_EMAIL=dev.user@example.com
# FAKE_OAUTH_SUB=fake-google-sub-000001
# Google sign-in is disabled until a real provider exists; when enabled in
# development the deterministic fake above is used, and enabling it in
# production is refused.
GOOGLE_OAUTH_ENABLED=false

# Optional: separate URL for the test suite (defaults to DATABASE_URL)
# TEST_DATABASE_URL=postgres://bikesnest:bikesnest@localhost:5432/bikesnest

# Privacy and account lifecycle.
# Temporary personal-data export lifetime (hours).
EXPORT_TTL_HOURS=24
# Inactive-account anonymization threshold in days (0 = disabled, config-gated).
# Decision 2026-09-03 (docs/retention-policy.md): stays OFF — accounts live until
# the user deletes them; there is no reminder e-mail yet, so silent anonymization
# would surprise users. The privacy policy says so.
INACTIVE_ACCOUNT_ANONYMIZE_AFTER_DAYS=0
# Deleted-account shell purge threshold in days (0 = disabled, config-gated).
# Decision 2026-09-03: 30 days. The shell holds no personal data after
# anonymization; the purge is housekeeping and matches the privacy policy.
DELETED_ACCOUNT_PURGE_AFTER_DAYS=30
# seed-policies: version + effective date for the policy_version
# rows. Bump POLICY_VERSION whenever policies/*.md change; the old version is
# kept as history.
# POLICY_VERSION=2026-09-05.2
# POLICY_EFFECTIVE_AT=2026-09-05T00:00:00Z
# seed-policies: controller identity + contact. These fill the {{TOKEN}}s
# in policies/*.md at seed time so the company details never live in the repo.
# The seeder REFUSES to run with any of them missing. The values below are dev
# placeholders — set the real legal entity in production.
POLICY_OPERATOR_NAME="BikesNest Dev Ltda. (DEV PLACEHOLDER)"
POLICY_OPERATOR_CNPJ="00.000.000/0000-00"
POLICY_OPERATOR_ADDRESS="Curitiba, PR, Brasil"
POLICY_CONTACT_EMAIL=privacidade@bikesnest.local

# --- Configurable tuning constants ---

# Recommendation weights. Sub-scores are 0..1; missing input → 0.5.
# REC_WEIGHT_DISTANCE=0.35
# REC_WEIGHT_SECURITY=0.25
# REC_WEIGHT_RATING=0.20
# REC_WEIGHT_FRESHNESS=0.15
# REC_WEIGHT_VERIFICATION=0.05
# (There is no candidate cap any more: the recommendation score is the search
# query's own sort key, so the database ranks every match and returns one page.)

# Freshness thresholds in days: fresh | recently verified |
# aging | stale; beyond stale_days → VeryStale. Never verified → Never.
# FRESHNESS_FRESH_DAYS=30
# FRESHNESS_RECENT_DAYS=90
# FRESHNESS_AGING_DAYS=180
# FRESHNESS_STALE_DAYS=365

# Photo pipeline limits. NOTE: the domain crate keeps these
# as its compile-time enforcement values; these env knobs document the intended
# production values and are wired where plumbing already exists.
# PHOTO_MAX_BYTES=10485760          # 10 MiB
# PHOTO_MAX_MEGAPIXELS=20
# PHOTO_THUMB_MAX_SIDE=400
# PHOTO_DERIVATIVE_QUALITY=85

# Moderation limits: max report body length + per-window limits.
# MOD_REPORT_DESC_MAX_LEN=1000
# MOD_REPORT_USER_LIMIT=10
# MOD_REPORT_IP_LIMIT=20

# Retention TTLs in seconds, each defaulting to the
# RetentionPolicy defaults (1h reset, 24h verification, 30d session, 90d parked,
# 24h export, 24h upload-orphan).
# RETENTION_PASSWORD_RESET_SECONDS=3600
# RETENTION_EMAIL_VERIFICATION_SECONDS=86400
# RETENTION_SESSION_IDLE_SECONDS=2592000
# RETENTION_PARKED_HERE_SECONDS=7776000
# RETENTION_EXPORT_SECONDS=86400
# RETENTION_UPLOAD_ORPHAN_SECONDS=86400

# --- Security headers / CSP ---
# TLS_ON=1                          # emit Strict-Transport-Security (required in production)
# CSP_TILE_HOSTS=https://tiles.openfreemap.org   # MapLibre style/tile/glyph origins
# CSP_GEOCODE_HOSTS=                # browser-reachable client-side geocoding origins (empty in dev)
# Object-storage origin(s) that parking photos are served from as direct (pre-signed)
# URLs, folded into img-src; for AWS this is typically https://<bucket>.s3.<region>.amazonaws.com
CSP_MEDIA_HOSTS=http://localhost:9000

# --- Rate limiter: shared ValKey backend (Redis-compatible) ---
# The app uses a ValKey sliding-window rate limiter for auth/photo/contribution/
# moderation. Without either knob it uses a per-process in-memory limiter, which
# production refuses to start on (N replicas would multiply every limit by N).
# A ValKey backend that cannot be reached at startup is an error, not a
# downgrade to in-memory.
#
# Single node (`ValKeyRateLimiter::single`):
# VALKEY_URL=valkey://localhost:6379
# Compose uses `valkey://valkey:6379` internally. Override that only when the app
# container should use another single-node endpoint.
# COMPOSE_VALKEY_URL=valkey://valkey:6379
#
# Cluster (comma-separated nodes, `ValKeyRateLimiter::cluster`; wins over VALKEY_URL):
# VALKEY_CLUSTER_URLS=valkey://node1:6379,valkey://node2:6379,valkey://node3:6379
#
# When ValKey is unreachable, fail OPEN (allow) by default so an outage does not
# 429 every rate-limited endpoint. Set to false to fail CLOSED (deny → 429) instead.
# RATE_LIMIT_FAIL_OPEN=true

# --- Location provider: fake, mapbox, or google (default fake) ---
# One setting selects server-side geocoding, address autocomplete, and the map
# renderer together. This keeps provider results on the matching provider's
# map. The fake profile is for development and uses OpenFreeMap for rendering;
# production refuses to start with it.
# LOCATION_PROVIDER=fake
#
# Requests to a hosted geocoder contain the typed address and a random
# autocomplete session token. They contain no BikesNest account identity,
# cookie, or browser IP. Hosted provider results are not cached by BikesNest.
# Search, autocomplete, and suggestion-resolution requests share the per-IP
# budget below; coordinates already present in a request do not call a provider.
# RATE_GEOCODE_PER_IP=60
# RATE_GEOCODE_WINDOW_SECS=900
#
# Mapbox profile. Use separate least-privilege tokens for server geocoding and
# browser map rendering. The browser token must be URL-restricted. Mapbox GL JS
# renders the configured style; the default is Mapbox Streets v12.
# MAPBOX_GEOCODING_ACCESS_TOKEN=pk.your_server_geocoding_token
# MAPBOX_MAP_ACCESS_TOKEN=pk.your_browser_map_token
# MAPBOX_STYLE_URL=mapbox://styles/mapbox/streets-v12
# Required Mapbox CSP origins are added automatically.
#
# Google profile. Enable Geocoding API and Places API (New) for the server key,
# and Maps JavaScript API for the browser key. Restrict the server key by API
# and deployment network; restrict the browser key by API and HTTP referrer.
# Advanced markers require a Google Cloud map ID.
# GOOGLE_MAPS_SERVER_API_KEY=your_server_key
# GOOGLE_MAPS_BROWSER_API_KEY=your_browser_key
# GOOGLE_MAP_ID=your_map_id
# Google Maps CSP origins are added automatically when this profile is active.
#
# Existing deployments may still use GEOCODER, MAPBOX_ACCESS_TOKEN, and
# MAP_STYLE_URL. LOCATION_PROVIDER and the dedicated variables above take
# precedence.

# --- Object storage: S3-compatible (MinIO for dev) ---
# The app stores photos/media in an S3-compatible bucket and serves them via
# direct S3 presigned URLs (the browser hits the bucket; the app is not a
# media proxy). Defaults target a local MinIO (docker compose), so `cargo run`
# works against the dev stack. Production gets NO defaults: set all of these or
# the app refuses to start (and `minioadmin` credentials are rejected outright).
# S3_ENDPOINT=http://localhost:9000   # set empty -> standard AWS endpoint
# Compose uses `http://minio:9000` internally. Override that only when the app
# container should use another S3-compatible endpoint.
# COMPOSE_S3_ENDPOINT=http://minio:9000
# Browser-facing endpoint used to generate presigned GET URLs. Set this when
# S3_ENDPOINT uses a private container/DNS name; defaults to S3_ENDPOINT.
# S3_PUBLIC_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=bikesnest
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# --- Background jobs: Postgres-backed queue ---
# An in-process worker polls a `background_job` table, claims due jobs, runs
# their handler, and records success / retry / dead-letter. All job times are UTC.
# Set `JOBS_ENABLED=false` on web-only instances (or to run jobs elsewhere).
# JOBS_ENABLED=true
# JOBS_POLL_INTERVAL_MS=5000
# JOBS_BATCH_SIZE=4
# JOBS_LEASE_TTL_MS=600000       # lease; a long job heartbeats to hold it
# JOBS_MAX_ATTEMPTS=5            # retry budget before dead-letter
# JOBS_BACKOFF_BASE_MS=2000      # exponential backoff base (x 2^(attempt-1) + jitter)
# JOBS_HISTORY_RETENTION_DAYS=7  # jobs.gc deletes terminal rows older than this
