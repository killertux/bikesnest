[Unit]
Description=BikesNest production application
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/home/bruno/Projects/bikenest
EnvironmentFile=/home/bruno/Projects/bikenest/.env
ExecStart=/home/bruno/Projects/bikenest/target/release/bikesnest-web serve
Restart=on-failure
RestartSec=10
TimeoutStopSec=45
UMask=0077
NoNewPrivileges=true
LimitNOFILE=65536

[Install]
WantedBy=default.target
